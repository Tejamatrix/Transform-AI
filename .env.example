# Copy to backend/.env and fill in your values.
# backend/.env is gitignored — NEVER commit real keys.

SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///./transformai.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# ---- AI providers ----
# Live LLM via any OpenAI-compatible gateway (b.ai, OpenAI, Groq, Ollama...).
# GLM_API_KEY takes precedence over OPENAI_API_KEY.
# With no key/funds the platform auto-falls back to the built-in offline engine.
LLM_PROVIDER=openai
GLM_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.b.ai/v1
LLM_MODEL=minimax-m2.7
# offline | strict  (offline = graceful fallback, strict = fail loudly)
LLM_FALLBACK=offline

# Embeddings: hashed (built-in, offline) | openai
EMBEDDING_PROVIDER=hashed
EMBEDDING_DIM=512

# ---- Optional system tools (enable image/video sources) ----
# Tesseract OCR  -> winget install UB-Mannheim.TesseractOCR
# FFmpeg         -> winget install Gyan.FFmpeg

CORS_ORIGINS=http://localhost:3000
